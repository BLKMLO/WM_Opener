<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="18dp"
    android:paddingBottom="32dp">

    <!-- Compteur -->
    <LinearLayout style="@style/Panel" android:padding="18dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/todayCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/outfit_extrabold"
                android:includeFontPadding="false"
                android:text="0"
                android:textColor="@color/fg"
                android:textSize="56sp" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:layout_marginBottom="8dp"
                android:text="paquets\naujourd'hui"
                android:textColor="@color/muted"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/totalCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:fontFamily="monospace"
                android:textColor="@color/faint"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Répartition par rareté des cartes détectées -->
        <LinearLayout
            android:id="@+id/rarityBar"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:background="@color/surface_hi" />
        <LinearLayout
            android:id="@+id/rarityLegend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal" />
    </LinearLayout>

    <!-- Mode auto -->
    <TextView style="@style/Label" android:text="Mode automatique" />
    <LinearLayout style="@style/Panel">
        <LinearLayout android:id="@+id/rowAuto" style="@style/Row" android:minHeight="64dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/outfit_semibold"
                    android:text="Ouvrir en arrière-plan"
                    android:textColor="@color/fg"
                    android:textSize="16sp" />
                <TextView
                    android:id="@+id/autoSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />
            </LinearLayout>
            <Switch
                android:id="@+id/autoSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:thumbTint="@color/fg"
                android:trackTint="@color/accent" />
        </LinearLayout>
        <View style="@style/Divider" />
        <LinearLayout style="@style/Row">
            <TextView style="@style/RowTitle" android:text="Dernier passage" />
            <TextView android:id="@+id/lastRun" style="@style/RowValue" />
        </LinearLayout>
        <View style="@style/Divider" />
        <LinearLayout style="@style/Row">
            <TextView style="@style/RowTitle" android:text="Prochain passage" />
            <TextView android:id="@+id/nextRun" style="@style/RowValue" />
        </LinearLayout>
    </LinearLayout>

    <TextView style="@style/Label" android:text="Fréquence" />
    <LinearLayout
        android:id="@+id/intervalChips"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/btnOpen"
            style="@style/Btn"
            android:background="@drawable/btn_primary"
            android:text="Ouvrir maintenant"
            android:textColor="@color/accent_ink" />
        <TextView
            android:id="@+id/btnDiagnose"
            style="@style/Btn"
            android:layout_marginStart="10dp"
            android:background="@drawable/btn_ghost"
            android:text="Diagnostic"
            android:textColor="@color/fg" />
    </LinearLayout>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="4dp"
        android:text="« Ouvrir maintenant » lance un passage en arrière-plan, comme le mode auto."
        android:textColor="@color/faint"
        android:textSize="12sp" />

    <TextView style="@style/Label" android:text="Autorisations" />
    <LinearLayout style="@style/Panel">
        <LinearLayout android:id="@+id/permNotif" style="@style/Row">
            <TextView style="@style/RowTitle" android:text="Notifications" />
            <TextView android:id="@+id/permNotifState" style="@style/RowValue" />
        </LinearLayout>
        <View style="@style/Divider" />
        <LinearLayout android:id="@+id/permBattery" style="@style/Row">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingTop="10dp" android:paddingBottom="10dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Batterie sans restriction" android:textColor="@color/fg" android:textSize="15sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sinon Android espace fortement les passages." android:textColor="@color/faint" android:textSize="12sp" />
            </LinearLayout>
            <TextView android:id="@+id/permBatteryState" style="@style/RowValue" />
        </LinearLayout>
        <View style="@style/Divider" />
        <LinearLayout android:id="@+id/permOverlay" style="@style/Row">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingTop="10dp" android:paddingBottom="10dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Superposition" android:textColor="@color/fg" android:textSize="15sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Laisse la page invisible jouer ses animations." android:textColor="@color/faint" android:textSize="12sp" />
            </LinearLayout>
            <TextView android:id="@+id/permOverlayState" style="@style/RowValue" />
        </LinearLayout>
    </LinearLayout>

    <TextView style="@style/Label" android:text="Avancé" />
    <LinearLayout style="@style/Panel">
        <LinearLayout android:id="@+id/rowDetect" style="@style/Row">
            <TextView style="@style/RowTitle" android:text="Détection des boutons" />
            <TextView style="@style/RowValue" android:text="›" android:textSize="18sp" />
        </LinearLayout>
        <View style="@style/Divider" />
        <LinearLayout android:id="@+id/rowMax" style="@style/Row">
            <TextView style="@style/RowTitle" android:text="Paquets max par passage" />
            <TextView android:id="@+id/maxValue" style="@style/RowValue" />
        </LinearLayout>
        <View style="@style/Divider" />
        <LinearLayout android:id="@+id/rowLog" style="@style/Row">
            <TextView style="@style/RowTitle" android:text="Journal technique" />
            <TextView style="@style/RowValue" android:text="›" android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/version"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:textColor="@color/faint"
        android:textSize="11sp" />
</LinearLayout>
